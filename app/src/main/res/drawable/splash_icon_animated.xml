<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_icon">
    <target android:name="blob">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:duration="520" android:valueFrom="0.4" android:valueTo="1" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:duration="520" android:valueFrom="0.4" android:valueTo="1" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="rotation" android:duration="800" android:valueFrom="-45" android:valueTo="0" android:interpolator="@android:anim/decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="hook">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:startOffset="200" android:duration="350" android:valueFrom="0" android:valueTo="1" android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="body">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:startOffset="380" android:duration="420" android:valueFrom="0" android:valueTo="1" android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>
    <target android:name="sparkle">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:startOffset="650" android:duration="300" android:valueFrom="0" android:valueTo="1" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:startOffset="650" android:duration="300" android:valueFrom="0" android:valueTo="1" android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
