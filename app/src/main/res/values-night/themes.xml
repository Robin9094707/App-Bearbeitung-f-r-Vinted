<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Glanz" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Glanz.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.Glanz</item>
    </style>
</resources>
